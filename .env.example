# Supabase: Project Settings → API. The service role key stays on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# AI provider key and model (checkpoint 2)
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
# Development only: scripted stand-in replies for UI work without a key
# NOOR_MOCK=1

# Password for /admin (checkpoint 3)
ADMIN_PASSWORD=
